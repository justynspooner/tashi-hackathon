{
  "id": "king_of_the_hill",
  "name": "King of the Hill",
  "teams": ["red", "blue"],
  "entity_types": [
    { "id": "hill",   "min": 1, "max": 1, "team": null,       "visual": "hill" },
    { "id": "player", "min": 2, "max": 4, "team": "per_team", "visual": "player" }
  ],
  "placement": [
    { "entity": "player", "requires": { "kind": "farther_than_m_from", "entity": "hill", "min_m": 6.0 } }
  ],
  "rules": [
    {
      "id": "hold_the_hill",
      "on": "tick",
      "when": { "kind": "all", "of": [
        { "kind": "entity_is", "entity_type": "player" },
        { "kind": "proximity_duration_s", "peer_entity_type": "hill", "max_m": 2.0, "min_s": 5 }
      ] },
      "effect": { "kind": "increment_score", "team": "self.team", "by": 1 }
    }
  ]
}
